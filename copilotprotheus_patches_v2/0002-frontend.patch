@@ -0,0 +1,2 @@
+import{useCallback,useState}from'react';import{postTurn}from'./api';import type{Message,TurnRequest}from'./types';
+const KEY='cprot_active_conversation_id';export function useConversationV2(id:string|null){const[messages,setMessages]=useState<Message[]>([]);const[processing,setProcessing]=useState(false);const[error,setError]=useState<string|null>(null);const send=useCallback(async(req:TurnRequest,signal?:AbortSignal)=>{if(!id)throw new Error('Conversa não inicializada.');setProcessing(true);setError(null);try{const x=await postTurn(id,req,signal);setMessages(v=>[...v,x.userMessage,x.assistantMessage]);localStorage.setItem(KEY,x.conversationId);return x}catch(e){setError(e instanceof Error?e.message:'Falha desconhecida.');throw e}finally{setProcessing(false)}},[id]);return{messages,processing,error,setMessages,send}}
