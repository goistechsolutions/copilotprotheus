diff --git a/frontend/src/features/copilot-chat/v2/api.ts b/frontend/src/features/copilot-chat/v2/api.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/copilot-chat/v2/api.ts
@@ -0,0 +1,2 @@
+import type{TurnRequest,TurnResponse}from'./types';
+export async function postTurn(id:string,body:TurnRequest,signal?:AbortSignal):Promise<TurnResponse>{const r=await fetch(`/api/copilot/conversations/${encodeURIComponent(id)}/turns`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),signal});const x=await r.json().catch(()=>null);if(!r.ok)throw Object.assign(new Error(x?.message??'Falha ao processar.'),{code:x?.code,traceId:x?.traceId});return x as TurnResponse}
diff --git a/frontend/src/features/copilot-chat/v2/useConversation.ts b/frontend/src/features/copilot-chat/v2/useConversation.ts
new file mode 100644
