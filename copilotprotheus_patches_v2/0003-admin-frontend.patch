diff --git a/admin-frontend/src/services/tenantScopedApi.js b/admin-frontend/src/services/tenantScopedApi.js
new file mode 100644
--- /dev/null
+++ b/admin-frontend/src/services/tenantScopedApi.js
@@ -0,0 +1,3 @@
+const BLOCKED=new Set(['tenantId','tenant_id','schemaName','schema_name']);
+export function stripAuthority(v){if(Array.isArray(v))return v.map(stripAuthority);if(!v||typeof v!=='object')return v;return Object.fromEntries(Object.entries(v).filter(([k])=>!BLOCKED.has(k)).map(([k,x])=>[k,stripAuthority(x)]));}
+export function createTenantApi(http){return{companies:()=>http.get('/api/admin/companies'),modules:(companyId)=>http.get(`/api/admin/companies/${encodeURIComponent(companyId)}/modules`),rules:(companyId)=>http.get('/api/admin/business-rules',{params:{companyId}}),saveRule:(body)=>http.post('/api/admin/business-rules',stripAuthority(body)),snapshots:(params)=>http.get('/api/admin/snapshots',{params})};}
