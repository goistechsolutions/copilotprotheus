+import re
+from dataclasses import dataclass
+from uuid import UUID
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import AsyncSession
+RX=re.compile(r"^[a-z][a-z0-9_]{2,62}$");RESERVED={"public","information_schema","pg_catalog"}
+class TenantContextError(RuntimeError):pass
+@dataclass(frozen=True,slots=True)
+class TenantContext:tenant_id:UUID;tenant_code:str;schema_name:str;user_id:UUID
+def quote_schema(name:str)->str:
+ if not RX.fullmatch(name) or name in RESERVED or name.startswith("pg_"):raise TenantContextError("Schema inválido")
+ return f'"{name}"'
+async def resolve_tenant(session:AsyncSession,tenant_id:UUID,user_id:UUID)->TenantContext:
+ q=text("SELECT t.id,t.tenant_code,t.schema_name FROM public.tenants t JOIN public.users u ON u.tenant_id=t.id WHERE t.id=:t AND u.id=:u AND t.status='ACTIVE' AND u.status='ACTIVE'")
+ row=(await session.execute(q,{"t":tenant_id,"u":user_id})).mappings().one_or_none()
+ if not row:raise TenantContextError("Tenant ou usuário não autorizado")
+ quote_schema(row["schema_name"]);return TenantContext(row["id"],row["tenant_code"],row["schema_name"],user_id)
