+from collections.abc import Callable
+from uuid import UUID
+from fastapi import APIRouter,Depends
+from .schemas import TurnRequest
+from .service import TurnService
+
+def create_router(session_dependency:Callable,tenant_dependency:Callable,pipeline_dependency:Callable)->APIRouter:
+ r=APIRouter(prefix="/api/copilot",tags=["copilot-v2"])
+ @r.post("/conversations/{conversation_id}/turns")
+ async def turn(conversation_id:UUID,request:TurnRequest,db=Depends(session_dependency),tenant=Depends(tenant_dependency),pipeline=Depends(pipeline_dependency)):
+  return await TurnService(db,pipeline).execute(tenant,conversation_id,request)
+ return r
