+from datetime import datetime
+from typing import Any,Literal
+from uuid import UUID
+from pydantic import BaseModel,ConfigDict,Field
+class Context(BaseModel):
+ model_config=ConfigDict(extra="forbid",populate_by_name=True)
+ company_id:UUID=Field(alias="companyId");environment_id:UUID=Field(alias="environmentId");module_sigla:str=Field(alias="moduleSigla")
+class TurnRequest(BaseModel):
+ model_config=ConfigDict(extra="forbid",populate_by_name=True)
+ client_message_id:UUID=Field(alias="clientMessageId");content:str=Field(min_length=1,max_length=10000);context:Context
+class Message(BaseModel):
+ model_config=ConfigDict(populate_by_name=True)
+ id:UUID;role:Literal["user","assistant"];content:str;analysis_id:UUID|None=Field(None,alias="analysisId");created_at:datetime=Field(alias="createdAt")
+class TurnResponse(BaseModel):
+ model_config=ConfigDict(populate_by_name=True)
+ conversation_id:UUID=Field(alias="conversationId");trace_id:UUID=Field(alias="traceId");user_message:Message=Field(alias="userMessage");assistant_message:Message=Field(alias="assistantMessage");analysis:dict[str,Any];dashboard:dict[str,Any]|None=None
