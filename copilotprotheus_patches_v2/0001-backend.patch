+from typing import Any,Protocol
+from uuid import UUID,uuid4
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import AsyncSession
+from .tenant import TenantContext,quote_schema
+from .schemas import TurnRequest
+class Pipeline(Protocol):
+ async def execute(self,**kwargs:Any)->dict[str,Any]:...
+class TurnService:
+ def __init__(self,db:AsyncSession,pipeline:Pipeline):self.db=db;self.pipeline=pipeline
+ async def execute(self,tenant:TenantContext,cid:UUID,req:TurnRequest)->dict[str,Any]:
+  s=quote_schema(tenant.schema_name);trace=uuid4()
+  async with self.db.begin():
+   if await self.db.scalar(text(f"SELECT 1 FROM {s}.copilot_conversations WHERE id=:c AND user_id=:u"),{"c":cid,"u":tenant.user_id}) is None:raise PermissionError("Conversa não autorizada")
+   user=(await self.db.execute(text(f"INSERT INTO {s}.copilot_messages(conversation_id,role,content,client_message_id) VALUES(:c,'user',:x,:m) RETURNING id,role,content,created_at"),{"c":cid,"x":req.content,"m":req.client_message_id})).mappings().one()
+   result=await self.pipeline.execute(tenant=tenant,conversation_id=cid,source_message_id=user["id"],request=req,trace_id=trace)
+   analysis=(await self.db.execute(text(f"INSERT INTO {s}.copilot_analyses(conversation_id,source_message_id,company_id,environment_id,module_id,validation_json,metrics_json,insights_json,presentation_json,trace_id) VALUES(:c,:sm,:co,:e,:mo,:v,:me,:i,:p,:t) RETURNING *"),{"c":cid,"sm":user["id"],"co":req.context.company_id,"e":req.context.environment_id,"mo":result.get("module_id"),"v":result["validation"],"me":result.get("metrics",{}),"i":result.get("insights",[]),"p":result.get("presentation",{}),"t":trace})).mappings().one()
+   assistant=(await self.db.execute(text(f"INSERT INTO {s}.copilot_messages(conversation_id,role,content,analysis_id) VALUES(:c,'assistant',:x,:a) RETURNING id,role,content,analysis_id,created_at"),{"c":cid,"x":result["answer"],"a":analysis["id"]})).mappings().one()
+   await self.db.execute(text(f"UPDATE {s}.copilot_analyses SET assistant_message_id=:m WHERE id=:a"),{"m":assistant["id"],"a":analysis["id"]})
+  return {"conversationId":cid,"traceId":trace,"userMessage":dict(user),"assistantMessage":dict(assistant),"analysis":dict(analysis),"dashboard":None}
