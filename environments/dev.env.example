# ╔══════════════════════════════════════════════════════════════╗
# ║  copilotprotheus — AMBIENTE: DEVELOPMENT                    ║
# ║  Para uso local com Docker Compose ou Hetzner dev.          ║
# ║  Copie para .env na raiz: cp environments/dev.env.example .env ║
# ║  NUNCA commite o .env com valores reais.                    ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Identificação do Ambiente ────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Banco de Dados (PostgreSQL + pgvector) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_local
POSTGRES_DB=copilot_protheus_dev
DATABASE_URL=postgresql+psycopg2://postgres:dev_password_local@db:5432/copilot_protheus_dev

# ── Backend / FastAPI ────────────────────────────────────────
# Pode usar qualquer string em dev; em hml/prod use: openssl rand -hex 32
SECRET_KEY=dev_insecure_secret_key_troque_em_hml_e_prod
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── LLM (OpenAI) ─────────────────────────────────────────────
# Use uma chave de sandbox ou projeto separado para dev
OPENAI_API_KEY=sk-COLE_CHAVE_DEV_AQUI
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cloudflare Tunnel ────────────────────────────────────────
# Não obrigatório em dev local; deixe vazio ou use um túnel de teste
CLOUDFLARE_TUNNEL_TOKEN=

# ── Tenant Piloto (Single-tenant / Teste) ────────────────────
TENANT_NAME=cliente_dev
PROTHEUS_REST_URL=https://protheus.cliente_dev.cloudtotvs.com.br:10707/rest
WEBAPP_URL=https://protheus.cliente_dev.cloudtotvs.com.br:10703/webapp/index.html
VSCODE_SERVER_URL=https://protheus.cliente_dev.cloudtotvs.com.br:10714
CLIENT_ID=
CLIENT_SECRET=
PROTHEUS_USER=usuario_api_dev
PROTHEUS_PASSWORD=TROQUE_ESTA_SENHA
AUTH_MODE=basic
TIMEOUT_SECONDS=120

# ── Observabilidade ──────────────────────────────────────────
# Em dev, logs vão direto ao stdout; não precisa de configuração extra
LOG_LEVEL=DEBUG
