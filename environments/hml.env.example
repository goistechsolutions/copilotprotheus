# ╔══════════════════════════════════════════════════════════════╗
# ║  copilotprotheus — AMBIENTE: HOMOLOGATION                   ║
# ║  Hetzner VPS (hml) — espelho funcional do prod.             ║
# ║  Copie para .env: cp environments/hml.env.example .env      ║
# ║  NUNCA commite o .env com valores reais.                    ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Identificação do Ambiente ────────────────────────────────
ENVIRONMENT=homologation
DEBUG=false

# ── Banco de Dados (PostgreSQL + pgvector) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GERE_SENHA_FORTE_openssl_rand_base64_24
POSTGRES_DB=copilot_protheus_hml
DATABASE_URL=postgresql+psycopg2://postgres:SENHA_HML@db:5432/copilot_protheus_hml

# ── Backend / FastAPI ────────────────────────────────────────
# Gere com: openssl rand -hex 32
SECRET_KEY=GERE_COM_openssl_rand_hex_32
# Subdomínio de homologação — ajuste conforme seu DNS
CORS_ORIGINS=https://hml.copilotprotheus.com.br,https://admin-hml.copilotprotheus.com.br

# ── LLM (OpenAI) ─────────────────────────────────────────────
# Use chave separada de hml para rastrear custos por ambiente
OPENAI_API_KEY=sk-COLE_CHAVE_HML_AQUI
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cloudflare Tunnel ────────────────────────────────────────
# Crie um túnel dedicado para hml em: Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=COLE_TOKEN_TUNNEL_HML_AQUI

# ── Tenant Piloto (Single-tenant / Teste) ────────────────────
TENANT_NAME=cliente_hml
PROTHEUS_REST_URL=https://protheus.cliente_hml.cloudtotvs.com.br:10707/rest
WEBAPP_URL=https://protheus.cliente_hml.cloudtotvs.com.br:10703/webapp/index.html
VSCODE_SERVER_URL=https://protheus.cliente_hml.cloudtotvs.com.br:10714
CLIENT_ID=
CLIENT_SECRET=
PROTHEUS_USER=usuario_api_hml
PROTHEUS_PASSWORD=TROQUE_ESTA_SENHA
AUTH_MODE=basic
TIMEOUT_SECONDS=120

# ── Observabilidade ──────────────────────────────────────────
LOG_LEVEL=INFO

# ── Notas de validação ───────────────────────────────────────
# Antes de promover hml → prod, execute:
#   python scripts/smoke_test_multitenant_v4.py
#   psql -f scripts/validate_schema_v4.sql
