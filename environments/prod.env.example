# ╔══════════════════════════════════════════════════════════════╗
# ║  copilotprotheus — AMBIENTE: PRODUCTION                     ║
# ║  Hetzner VPS (prod) + Cloudflare (frontend do agente).      ║
# ║  Copie para .env: cp environments/prod.env.example .env     ║
# ║  NUNCA commite o .env com valores reais.                    ║
# ║  Em produção, prefira injetar via GitHub Secrets + Actions. ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Identificação do Ambiente ────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Banco de Dados (PostgreSQL + pgvector) ───────────────────
# Senha deve ter ≥ 24 caracteres — gere com: openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GERE_SENHA_FORTE_openssl_rand_base64_24
POSTGRES_DB=copilot_protheus
# Em prod, o host pode ser 'db' (Docker interno) ou IP externo se usar managed DB
DATABASE_URL=postgresql+psycopg2://postgres:SENHA_PROD@db:5432/copilot_protheus

# ── Backend / FastAPI ────────────────────────────────────────
# OBRIGATÓRIO: gere com openssl rand -hex 32 e armazene no GitHub Secret SECRET_KEY
SECRET_KEY=GERE_COM_openssl_rand_hex_32_E_SALVE_NO_GITHUB_SECRET
# Domínios reais de produção (sem barra final)
CORS_ORIGINS=https://copilotprotheus.com.br,https://admin.copilotprotheus.com.br,https://app.copilotprotheus.com.br

# ── LLM (OpenAI) ─────────────────────────────────────────────
# Use projeto/chave dedicado de produção — monitore cotas e custos
OPENAI_API_KEY=sk-COLE_CHAVE_PROD_AQUI_VIA_GITHUB_SECRET
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cloudflare Tunnel ────────────────────────────────────────
# Crie túnel dedicado de prod em: Cloudflare Zero Trust → Networks → Tunnels
# Rotacione o token se ele tiver sido exposto em commits anteriores
CLOUDFLARE_TUNNEL_TOKEN=COLE_TOKEN_TUNNEL_PROD_AQUI_VIA_GITHUB_SECRET

# ── Tenant Piloto (Single-tenant) ────────────────────────────
TENANT_NAME=cliente_prod
PROTHEUS_REST_URL=https://protheus.cliente.cloudtotvs.com.br:10707/rest
WEBAPP_URL=https://protheus.cliente.cloudtotvs.com.br:10703/webapp/index.html
VSCODE_SERVER_URL=https://protheus.cliente.cloudtotvs.com.br:10714
CLIENT_ID=
CLIENT_SECRET=
PROTHEUS_USER=usuario_api_prod
PROTHEUS_PASSWORD=TROQUE_ESTA_SENHA
AUTH_MODE=basic
TIMEOUT_SECONDS=120

# ── Observabilidade ──────────────────────────────────────────
LOG_LEVEL=WARNING

# ── Checklist pré-deploy prod ─────────────────────────────────
# [ ] SECRET_KEY rotacionada (diferente de hml)
# [ ] POSTGRES_PASSWORD forte e diferente de hml
# [ ] OPENAI_API_KEY de projeto separado
# [ ] CLOUDFLARE_TUNNEL_TOKEN novo (nunca reutilize o de hml)
# [ ] CORS_ORIGINS contém apenas domínios de produção
# [ ] Alembic migration testada em hml antes do deploy
# [ ] Smoke test executado em hml: python scripts/smoke_test_multitenant_v4.py
