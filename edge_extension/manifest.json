{
  "manifest_version": 3,
  "name": "Copilot Protheus - Assistente",
  "version": "1.0.1",
  "description": "Assistente integrado ao WebApp da TOTVS Protheus",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copilot Protheus"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.protheus.cloudtotvs.com.br/*",
        "https://*.cloudtotvs.com.br/*",
        "https://*.totvs.com.br/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Mostrar/Ocultar Widget Copilot Protheus"
    }
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*.protheus.cloudtotvs.com.br/*",
    "https://*.cloudtotvs.com.br/*",
    "https://*.totvs.com.br/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["widget.css"],
      "matches": ["<all_urls>"]
    }
  ]
}