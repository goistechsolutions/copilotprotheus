{
  "manifest_version": 3,
  "name": "Copilot Protheus - Assistente",
  "version": "1.0.0",
  "description": "Assistente integrado ao WebApp da TOTVS Protheus",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copilot Protheus"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.totvs.com.br/*","https://copilot.elitecorp.tec.br/*","https://rodolltda195384.protheus.cloudtotvs.com.br*"],
      "js": ["content-script.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Mostrar/Ocultar Widget Copilot Protheus"
    }
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://*.totvs.com.br/*","https://copilot.elitecorp.tec.br/*","https://rodolltda195384.protheus.cloudtotvs.com.br*"],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}