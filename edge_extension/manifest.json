{
  "manifest_version": 3,
  "name": "Copilot Protheus",
  "version": "1.1.0",
  "description": "Assistente Copilot Protheus integrado ao WebApp TOTVS",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": [
    "*://*.cloudtotvs.com.br/*",
    "https://copilot-api.elitecorp.tec.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cloudtotvs.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copilot Protheus"
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  }
}
