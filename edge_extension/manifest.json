{
  "manifest_version": 3,
  "name": "Copilot Protheus - Assistente",
  "version": "1.0.0",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.totvs.com/*"],
      "js": ["content-script.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://*.totvs.com/*"]
}
