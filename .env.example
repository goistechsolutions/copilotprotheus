# ╔══════════════════════════════════════════════════════════════╗
# ║  copilotprotheus — variáveis de ambiente (raiz do projeto)  ║
# ║  Copie para .env e preencha os valores reais.               ║
# ║  NUNCA commite o .env com valores reais.                    ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Banco de Dados (PostgreSQL + pgvector) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=copilot_protheus
# Usado pelo docker-compose para injetar no container backend:
DATABASE_URL=postgresql+psycopg2://postgres:TROQUE_ESTA_SENHA@db:5432/copilot_protheus

# ── Backend / FastAPI ────────────────────────────────────────
# Gere com: openssl rand -hex 32
SECRET_KEY=GERE_COM_openssl_rand_hex_32
ENVIRONMENT=development
# Em produção, ajuste para os domínios reais (sem barra final):
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEBUG=true

# ── LLM (OpenAI) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-COLE_SUA_CHAVE_AQUI
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cloudflare Tunnel ────────────────────────────────────────
# Obtenha em: Cloudflare Zero Trust → Networks → Tunnels
# REVOGUE qualquer token anterior exposto em commits.
CLOUDFLARE_TUNNEL_TOKEN=COLE_TOKEN_AQUI

# ── Tenant Piloto (Single-tenant / Teste) ────────────────────
TENANT_NAME=cliente_exemplo
PROTHEUS_REST_URL=https://protheus.cliente_exemplo.cloudtotvs.com.br:10707/rest
WEBAPP_URL=https://protheus.cliente_exemplo.cloudtotvs.com.br:10703/webapp/index.html
VSCODE_SERVER_URL=https://protheus.cliente_exemplo.cloudtotvs.com.br:10714
CLIENT_ID=
CLIENT_SECRET=
PROTHEUS_USER=usuario_api
PROTHEUS_PASSWORD=TROQUE_ESTA_SENHA
AUTH_MODE=basic
TIMEOUT_SECONDS=120
