# RAG e narrativa corporativa: Phi-3.5 servido por API OpenAI-compatible
LLM_RAG_BASE_URL=http://127.0.0.1:8000/v1
LLM_RAG_MODEL=phi35

# Assistência de código: Qwen2.5-Coder 3B via Ollama-Arc
LLM_CODE_BASE_URL=http://127.0.0.1:11434
LLM_CODE_MODEL=qwen2.5-coder:3b
LLM_OLLAMA_KEEP_ALIVE=5m

LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_AUDIT_ENABLED=true
