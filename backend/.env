# ==============================================================================
# COPILOT PROTHEUS - CONFIGURAÇÃO DE AMBIENTE CLOUD / MULTIEMPRESA (HETZNER/AWS)
# ==============================================================================
# ATENÇÃO: Em ambiente Cloud Multiempresa (Multi-tenant), as credenciais e URLs
# de conexão ao Protheus NÃO devem ser fixadas neste arquivo. Todas as conexões,
# URLs REST, tokens e grupos de empresas são gerenciados dinamicamente no
# PostgreSQL por cada Tenant / Empresa via Painel Administrativo.
#
# As configurações abaixo definem a infraestrutura global do microsserviço.
# ==============================================================================

# --- BANCO DE DADOS (Postgres com pgvector & Driver TOTVS) ---
DATABASE_URL=postgresql+psycopg2://postgres:sap_password_123@db:5432/copilot_protheus
# Driver do banco Protheus (TOTVS Cloud): "oracle" (Padrão) | "mssql"
DB_DRIVER=oracle

# --- AUTENTICAÇÃO E SEGURANÇA (JWT & CORS) ---
JWT_SECRET=copilot-protheus-secret-key-change-me-in-production
JWT_EXPIRY_SECONDS=3600
CORS_ORIGIN=https://copilot.suaempresa.com.br,https://admin.suaempresa.com.br

# --- CREDENCIAIS DE GESTÃO DO PAINEL ADMINISTRATIVO GERAL (Super Admin / Adminer) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-super-strong-password

# --- PROVEDOR DE INTELIGÊNCIA ARTIFICIAL ---
LLM_BACKEND=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=sua_chave_de_api_gemini

# Configurações Alternativas (Ollama / IA Local ou Dedicado)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b

# --- ARMAZENAMENTO DE ARQUIVOS E KNOWLEDGE BASE (Cloudflare R2) ---
R2_ENDPOINT_URL=https://6c3688b19f3b7a74a4e5e6145ac15593.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=33f6aed10118972594cde792e86079bf
R2_SECRET_ACCESS_KEY=06fb357d652fc8eadc1f58c48a09834d2b332789922b3fcee3c0b40f251661ba
R2_BUCKET_NAME=copilot-knowledge

# --- TIMEOUT E LOGS GERAIS ---
TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# --- INFRAESTRUTURA CLOUDFLARE E HETZNER (Automacão e Proxy) ---
HETZNER_API_TOKEN=JKSlnvdxCSxh48FXi3MVibsPPrOkx18nIekIR2WRfYgF3NJlFKYhtUyYGzt98VHT
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
