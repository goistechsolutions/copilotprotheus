# --- Configurações do Protheus ---
PROTHEUS_REST_URL=https://rodolltda195384.protheus.cloudtotvs.com.br:10707/rest
PROTHEUS_USER=admin
PROTHEUS_PASSWORD=

# --- Configurações da IA (Ollama / OVMS / Gemini) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
LLM_BACKEND=ollama

# --- Configurações do Banco de Dados ---
# Substitua pela sua URL do Supabase em produção:
# Ex: postgresql+psycopg2://postgres:[password]@[host]:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:sap_password_123@localhost:5432/copilot_protheus

# Driver do banco Protheus: "oracle" para TOTVS Cloud (DBACCESS Oracle) | "mssql" para SQL Server
DB_DRIVER=oracle

# --- Configurações de Segurança ---
JWT_SECRET=copilot-protheus-dev-secret-change-me
JWT_EXPIRY_SECONDS=3600
CORS_ORIGIN=*

# --- Cloudflare R2 (Armazenamento de Arquivos) ---
R2_ENDPOINT_URL=https://[account_id].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=copilot-knowledge
